{
  "manifest_version": 3,
  "name": "Jarvis Coursera Link",
  "version": "1.0",
  "description": "Lets Jarvis play, pause and skip Coursera videos, and can autoplay the next video when one ends.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.coursera.org/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Jarvis Coursera Link" }
}
